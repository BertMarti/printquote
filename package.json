{
  "name": "printquote",
  "private": true,
  "version": "1.1.0",
  "description": "Presupuesta una impresión 3D en el navegador a partir de un STL.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "predev": "node scripts/comprobar-node.mjs",
    "dev": "vite",
    "prebuild": "node scripts/comprobar-node.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample": "node scripts/generate-sample.mjs",
    "test:integracion": "node scripts/integracion.mjs",
    "medir": "node scripts/medir-carga.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
